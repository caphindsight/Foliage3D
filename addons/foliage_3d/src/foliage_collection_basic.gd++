/// A readily available implementation for the [FoliageLayerBasic].
/// This should be enough for most basic use cases, like placing some trees and grass.
/// For more advanced use cases, implement your own subclass of [FoliageLayer].
@icon("pkg://icons/foliage_collection.svg")
@profile("foliage")
class_name FoliageCollectionBasic
extends Resource

/// A list of assets to place.
@export var assets: Array[FoliageAsset]

/// Weights of each of the asset from the list above, in the same order.
/// If unspecified, weights are assumed to be uniform.
@export var weights: PackedFloat32Array {
  decl {
    PackedFloat32Array weights_;
    PackedFloat64Array cumulative_probabilities_;
  }
  get {
    return weights_;
  }
  set(value) {
    weights_ = value;
    double total_weight = 0;
    for (float weight : weights_) {
      total_weight += weight;
    }
    cumulative_probabilities_.resize(weights_.size());
    double cumulative = 0;
    for (int64_t i = 0; i < weights_.size(); i++) {
      cumulative += weights_[i] / total_weight;
      cumulative_probabilities_[i] = cumulative;
    }
  }
}

/// Assets will be only placed on the selected terrain texture ids.
@export var textures: PackedInt32Array {
  decl {
    PackedInt32Array textures_;
    uint64_t texture_mask_ = 0;
  }
  get {
    return textures_;
  }
  set(value) {
    textures_ = value;
    texture_mask_ = 0;
    for (int32_t id : textures_) {
      if (id >= 0 && id < 64) {
        texture_mask_ |= 1ull << id;
      }
    }
  }
}

/// Base probability of finding an asset of this collection at a lattice point.
@export var density: float = 1.0

/// If specified, allows specifying the dependence of the asset density on height.
@export var height_density_curve: Curve

/// If specified, allows specifying the dependence of the asset density on the terrain slope (in degrees).
@export var slope_density_curve: Curve

/// If specified, allows specifying the dependence of the asset density on a 2d noise (in world coordinates).
@export var density_noise: Noise

/// Returns the probability of an asset from this collection to be placed at a specific location.
@const
func get_collection_probability(placement: FoliagePlacement, i: int) -> float {
  double probability = density;
  if (texture_mask_ != 0) {
    probability *= texture_weight(placement->base_texture_ids[i]) * (1 - placement->texture_blend_amounts[i]) +
        texture_weight(placement->overlay_texture_ids[i]) * placement->texture_blend_amounts[i];
  }
  Vector3 position = placement->get_transform(i).origin;
  if (height_density_curve.is_valid()) {
    probability *= height_density_curve->sample(position.y);
  }
  if (slope_density_curve.is_valid()) {
    probability *= slope_density_curve->sample(Math::rad_to_deg(placement->get_slope(i)));
  }
  if (density_noise.is_valid()) {
    probability *= density_noise->get_noise_2d(position.x, position.z) / 2.0 + 0.5;
  }
  return probability;
}

/// Given a uniformly distributed between [0..1) number, return an asset.
@const
func get_asset(uniform: float) -> FoliageAsset {
  int64_t index = cumulative_probabilities_.is_empty()
      ? (uniform * assets.size()) as int64_t
      : cumulative_probabilities_.bsearch(uniform);
  return index < assets.size() ? assets[index] as Ref<FoliageAsset> : nullptr;
}

decl {
  // 1 if the texture is one of [member textures], 0 otherwise.
  double texture_weight(int64_t id) const {
    return id >= 0 && id < 64 && (texture_mask_ & (1ull << id)) ? 1.0 : 0.0;
  }
}
