/// Renders all instances of one mesh in a chunk.
/// If [member scene] is set, it turns the instances into instances of the scene, one per frame,
/// which makes nearby foliage interactive.
@profile("foliage")
class_name FoliageMultiMesh
extends MultiMeshInstance3D

var scene: PackedScene
var scene_mode: FoliageSceneMode

decl {
  int64_t count_ = 0;
}

on ready {
  Gd<MultiMesh> mm = get_multimesh();
  count_ = mm ? mm->get_visible_instance_count() : 0;
  if (count_ < 0) {
    count_ = mm->get_instance_count();  // -1 means all instances are visible.
  }
}

on process(delta: float) {
  if (!scene || count_ == 0) {
    set_process(false);
    return;
  }
  Gd<MultiMesh> mm = get_multimesh();
  count_--;
  if (scene_mode == FoliageSceneMode::REPLACE) {
    mm->set_visible_instance_count(count_);
  }
  Gd<Node> instance = scene->instantiate();
  if (auto instance3d = instance as Gd<Node3D>) {
    instance3d->set_transform(mm->get_instance_transform(count_));
  }
  add_child(instance);
}
